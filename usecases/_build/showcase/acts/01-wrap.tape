Output acts/01-wrap.mp4
Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 21
Set Width 1500
Set Height 820
Set TypingSpeed 30ms
Set BorderRadius 20
Set WindowBar "Rings"
Set Padding 24
Type "clear" Sleep 300ms Enter
Type "python3 -m venv env" Sleep 500ms Enter
Sleep 5s
Type "source env/bin/activate" Sleep 400ms Enter
Sleep 2s
Type "pip install -q backstop-ai" Sleep 500ms Enter
Sleep 18s
Type "python show_version.py" Sleep 400ms Enter
Sleep 4s
