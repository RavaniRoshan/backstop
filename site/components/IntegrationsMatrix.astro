---
/**
 * What Backstop can point at.
 *
 * The honest answer to "how many servers does this work with?" is: one wire
 * protocol, and every server that speaks it. The enforcement engine does not
 * know what a provider is — it counts requests, tokens and concurrency. So
 * this is not a list of plugins Backstop ships. It is a list of the servers
 * an operator can actually point Backstop at, and the one thing that differs
 * between them: whether Backstop knows what a token costs.
 *
 * The four lanes are not drawn the same way, because they are not the same
 * shape. A lane that names two things gets cards, because two things you
 * choose between deserve to be chosen between properly. A lane that names
 * seven gets a shelf you pull from.
 */
import ProviderStrip from "./ProviderStrip.astro";
import ProviderCards from "./ProviderCards.astro";
import "../styles/integrations.css";

type Provider = { slug: string | null; name: string };

type Lane = {
  id: string;
  label: string;
  speaks: string;
  providers: Provider[];
  adds: string;
  /** How the lane is drawn. */
  device: "cards" | "marquee";
  /** Which way a marquee travels. */
  direction?: "left" | "right";
  /** A short tag beside the lane's name — why this lane is different. */
  tag?: string;
};

const lanes: Lane[] = [
  {
    id: "native",
    label: "The provider's own API",
    speaks: "their own endpoints",
    device: "cards",
    tag: "priced",
    providers: [
      { slug: "openai", name: "OpenAI" },
      { slug: "anthropic", name: "Anthropic" },
    ],
    adds:
      "Budgets, breaker, concurrency — and a price, read from the catalogue that ships inside Backstop.",
  },
  {
    id: "servers",
    label: "Inference servers you run",
    speaks: "an OpenAI-compatible endpoint",
    device: "marquee",
    direction: "left",
    providers: [
      { slug: "vllm", name: "vLLM" },
      { slug: null, name: "SGLang" },
      { slug: null, name: "llama.cpp" },
      { slug: "ollama", name: "Ollama" },
      { slug: "lmstudio", name: "LM Studio" },
      { slug: "docker", name: "Docker Model Runner" },
      { slug: "huggingface", name: "TGI" },
    ],
    adds:
      "The same budgets, the same breaker, the same concurrency limit. No price until you file one.",
  },
  {
    id: "managed",
    label: "Managed inference",
    speaks: "an OpenAI-compatible endpoint",
    device: "marquee",
    direction: "right",
    providers: [
      { slug: "deepinfra", name: "DeepInfRA" },
      { slug: "together", name: "Together AI" },
      { slug: "groq", name: "Groq" },
      { slug: null, name: "Fireworks" },
      { slug: "openrouter", name: "OpenRouter" },
      { slug: "replicate", name: "Replicate" },
      { slug: "baseten", name: "Baseten" },
      { slug: "cohere", name: "Cohere" },
      { slug: "mistral", name: "Mistral" },
      { slug: "nvidia", name: "NVIDIA" },
    ],
    adds:
      "The same budgets, the same breaker, the same concurrency limit. No price until you file one.",
  },
  {
    id: "gateways",
    label: "Cloud gateways",
    speaks: "an OpenAI-compatible gateway",
    device: "cards",
    providers: [
      { slug: "aws", name: "Amazon Bedrock" },
      { slug: "azure", name: "Azure OpenAI" },
      { slug: "vertex", name: "Google Vertex AI" },
    ],
    adds:
      "The same budgets, the same breaker, the same concurrency limit. No price until you file one.",
  },
];

const total = lanes.reduce((sum, lane) => sum + lane.providers.length, 0);
---

<section class="integrations">
  <div class="lanes">
    {
      lanes.map((lane, laneIndex) => (
        <article class="lane" data-lane={lane.id}>
          <p class="lane-index">{String(laneIndex + 1).padStart(2, "0")}</p>
          <div class="lane-head">
            <h3 class="lane-title" data-reveal>
              {lane.label}
            </h3>
            {lane.tag ? <span class="lane-tag">{lane.tag}</span> : null}
          </div>

          <div class="lane-body" data-reveal>
            {lane.device === "cards" ? (
              <ProviderCards providers={lane.providers} />
            ) : (
              <ProviderStrip
                providers={lane.providers}
                direction={lane.direction}
              />
            )}
            <p class="lane-speaks">
              They speak <strong>{lane.speaks}</strong>.
            </p>
            <p class="lane-adds">
              <span class="lane-adds-label">Backstop adds</span>
              {lane.adds}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <p class="integrations-caption">
    <strong>{total} servers.</strong> One wire protocol, one enforcement engine, no per-provider plugin. The only thing that changes between them is the price list: OpenAI and Anthropic models are priced from the catalogue that ships inside Backstop, and everything else is unpriced until you file a price for it — because a dollar ceiling with no price is a guess, and a guess is not a limit.
  </p>
</section>
