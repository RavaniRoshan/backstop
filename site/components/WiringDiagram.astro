---
/**
 * The wiring diagram: the agents, the guardrail, the endpoints.
 *
 * Three columns, one story. The agents on the left are the things that make
 * the calls. Backstop in the middle decides whether a call is allowed. The
 * endpoint shapes on the right are what actually serves the model.
 *
 * Every mark is the real one, compiled from the committed SVGs, so nothing is
 * fetched and nothing is invented.
 */
import { logos } from "../src/data/logos";
import "../styles/diagram.css";

const agents = [
  { slug: "claude-code" },
  { slug: "cursor" },
  { slug: "copilot" },
  { slug: "codex" },
  { slug: "antigravity" },
  { slug: "cline" },
];

const endpoints = [
  {
    slug: "openai",
    label: "OpenAI-compatible",
    notes: ["the shape most servers speak"],
  },
  {
    slug: "anthropic",
    label: "Anthropic-compatible",
    notes: ["the shape Claude serves"],
  },
  {
    slug: null,
    label: "Any OpenAI-compatible host",
    notes: ["vLLM · SGLang · Ollama · TGI", "llama.cpp · LM Studio · Docker"],
  },
];

/* The geometry, in one place, so the wires and the tiles cannot drift. */
const TILE = 40;
const LEFT = 48;
const TOP = 62;
const STEP = 56;
const BUS = 140;
const HUB = { x: 470, y: 210, r: 54 };
const END = 760;
const MARK = 44;
const WIDTH = 1120;

const agentRows = agents.map((agent, index) => ({
  slug: agent.slug,
  title: logos[agent.slug]?.title ?? agent.slug,
  x: LEFT,
  y: TOP + index * STEP,
  cy: TOP + index * STEP + TILE / 2,
}));

const busTop = agentRows[0].cy;
const busBottom = agentRows[agentRows.length - 1].cy;

const endNodes = endpoints.map((endpoint, index) => ({
  ...endpoint,
  x: END,
  y: 90 + index * 120,
  cy: 90 + index * 120,
  title: endpoint.slug ? (logos[endpoint.slug]?.title ?? endpoint.slug) : endpoint.label,
}));
---

<figure class="diagram">
  <svg
    viewBox={`0 0 ${WIDTH} 400`}
    role="img"
    aria-labelledby="diagram-title diagram-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="diagram-title">Agents, Backstop, and the endpoints</title>
    <desc id="diagram-desc">
      Coding agents on the left send their requests into Backstop, which
      enforces a budget, a circuit breaker and a concurrency limit, and then
      forwards them to an OpenAI-compatible or an Anthropic-compatible
      endpoint.
    </desc>

    <defs>
      <linearGradient id="dial" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#B91C1C" />
        <stop offset="1" stop-color="#EA580C" />
      </linearGradient>
      <linearGradient id="needle" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#EF4444" />
        <stop offset="1" stop-color="#FDE047" />
      </linearGradient>
    </defs>

    <!-- the bus the agents feed into -->
    <path
      id="bus"
      class="wire"
      d={`M ${BUS} ${busTop} L ${BUS} ${busBottom}`}
      style="--delay: 0.5s"
    />
    <path
      id="bus-to-hub"
      class="wire wire-live"
      d={`M ${BUS} ${HUB.y} L ${HUB.x - HUB.r} ${HUB.y}`}
      style="--delay: 0.9s"
    />

    <!-- each agent into the bus -->
    {
      agentRows.map((agent, index) => (
        <path
          class="wire"
          d={`M ${agent.x + TILE} ${agent.cy} L ${BUS} ${agent.cy}`}
          style={`--delay: ${0.15 + index * 0.07}s`}
        />
      ))
    }

    <!-- the hub out to each endpoint -->
    {
      endNodes.map((node, index) => (
        <path
          id={`out-${index}`}
          class="wire wire-live"
          d={`M ${HUB.x + HUB.r} ${HUB.y} C ${HUB.x + 130} ${HUB.y}, ${node.x - 90} ${node.cy}, ${node.x} ${node.cy}`}
          style={`--delay: ${1.1 + index * 0.12}s`}
        />
      ))
    }

    <!-- the travelling pulses -->
    <circle class="pulse" r="2.6">
      <animateMotion dur="3.4s" repeatCount="indefinite" begin="1.4s">
        <mpath href="#bus-to-hub" />
      </animateMotion>
    </circle>
    {
      endNodes.map((node, index) => (
        <circle class="pulse" r="2.6">
          <animateMotion
            dur="3.4s"
            repeatCount="indefinite"
            begin={`${1.6 + index * 0.4}s`}
          >
            <mpath
              href={`#out-${index}`}
            />
          </animateMotion>
        </circle>
      ))
    }

    <!-- the agents -->
    {
      agentRows.map((agent) => (
        <g class="node agent" data-agent={agent.slug}>
          <title>{agent.title}</title>
          <rect
            x={agent.x - 8}
            y={agent.y - 8}
            width={TILE + 16}
            height={TILE + 16}
            rx="10"
            class="node-plate"
          />
          <svg
            class:list={["mark", logos[agent.slug]?.monochrome && "mono"]}
            viewBox={logos[agent.slug]?.viewBox ?? "0 0 24 24"}
            x={agent.x}
            y={agent.y}
            width={TILE}
            height={TILE}
            role="img"
            aria-label={agent.title}
            set:html={logos[agent.slug]?.body ?? ""}
          />
        </g>
      ))
    }

    <!-- Backstop -->
    <g class="node hub">
      <circle cx={HUB.x} cy={HUB.y} r={HUB.r + 10} class="node-plate hub-plate" />
      <circle cx={HUB.x} cy={HUB.y} r="40" fill="url(#dial)" />
      <path
        d={`M ${HUB.x - 26} ${HUB.y + 24} A 34 34 0 1 1 ${HUB.x + 26} ${HUB.y + 24}`}
        fill="none"
        stroke="#FFF7ED"
        stroke-width="6"
        stroke-linecap="round"
      />
      <line
        x1={HUB.x}
        y1={HUB.y}
        x2={HUB.x}
        y2={HUB.y - 32}
        stroke="url(#needle)"
        stroke-width="6"
        stroke-linecap="round"
      />
      <text x={HUB.x} y={HUB.y + 74} class="label hub-label">Backstop</text>
      <text x={HUB.x} y={HUB.y + 90} class="sub">budget · breaker · concurrency</text>
    </g>

    <!-- the endpoints -->
    {
      endNodes.map((node) => (
        <g class="node endpoint">
          <title>{node.title}</title>
          {node.slug ? (
            <>
              <rect
                x={node.x - 8}
                y={node.cy - MARK / 2 - 8}
                width={MARK + 16}
                height={MARK + 16}
                rx="10"
                class="node-plate"
              />
              <svg
                class:list={["mark", logos[node.slug]?.monochrome && "mono"]}
                viewBox={logos[node.slug]?.viewBox ?? "0 0 24 24"}
                x={node.x}
                y={node.cy - MARK / 2}
                width={MARK}
                height={MARK}
                role="img"
                aria-label={node.title}
                set:html={logos[node.slug]?.body ?? ""}
              />
            </>
          ) : (
            <g class="generic">
              <rect
                x={node.x}
                y={node.cy - MARK / 2}
                width={MARK}
                height={MARK}
                rx="10"
                class="generic-plate"
              />
              <path
                d={`M ${node.x + 13} ${node.cy + 7} h 18 M ${node.x + 13} ${node.cy - 1} h 18 M ${node.x + 13} ${node.cy - 9} h 11`}
                class="generic-lines"
              />
            </g>
          )}
          <text x={node.x + 56} y={node.cy - 2} class="label">{node.label}</text>
          {node.notes.map((note, noteIndex) => (
            <text x={node.x + 56} y={node.cy + 15 + noteIndex * 15} class="sub">
              {note}
            </text>
          ))}
        </g>
      ))
    }
  </svg>

  <figcaption>
    Every agent on the left talks to Backstop. Backstop decides whether the
    call is allowed, then forwards it to whatever is serving the model. The
    limit does not change with the provider. The price list does.
  </figcaption>
</figure>
