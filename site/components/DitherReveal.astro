---
/**
 * A dithered image that tears open into full colour where the cursor sweeps.
 *
 * Originkit's `dither-reveal` component, ported to this site's rules: no
 * client framework, nothing fetched at runtime, and a theme that is part of
 * the design rather than an afterthought. The component arrives as a React
 * component with a remote image; this is the same shader, driven by a plain
 * script, drawing the repository's own dashboard screenshot.
 *
 * Decorative: it is behind the hero's words, it never takes a pointer event,
 * and the plain image underneath is what a reader without WebGL sees.
 */
import "../styles/dither.css";

interface Props {
  /** The image to dither. Served by the site; nothing is fetched. */
  src: string;
  /** The dither pattern: `bayer8`, `lines` or `noise`. */
  style?: "bayer8" | "lines" | "noise";
  /** The size of one dither cell, in pixels. */
  dotSize?: number;
  /** How far the reveal reaches, in pixels. */
  radius?: number;
  /** How soft the edge of the reveal is, 0 to 100. */
  softness?: number;
  /** The wave's speed. `off` stops it. */
  waveSpeed?: number;
  /** How often the wave repeats across the image. */
  density?: number;
}

const {
  src,
  style = "bayer8",
  dotSize = 5,
  radius = 100,
  softness = 50,
  waveSpeed = 82,
  density = 25,
} = Astro.props;
---

<div
  class="dither"
  data-dither-reveal
  data-dither-src={src}
  data-dither-style={style}
  data-dither-dot-size={dotSize}
  data-dither-radius={radius}
  data-dither-softness={softness}
  data-dither-wave-speed={waveSpeed}
  data-dither-density={density}
  aria-hidden="true"
>
  <img class="dither-fallback" src={src} alt="" decoding="async" />
  <canvas class="dither-canvas"></canvas>
</div>

<script>
  import { mountDitherReveals } from "../src/scripts/dither-reveal";

  mountDitherReveals();
</script>
